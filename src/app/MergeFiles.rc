    ID_FILE_PRINT_PREVIEW   "Show how the comparison will print\nPrint preview"
    ID_BOOKMARK_COMMENT     "Add or edit a comment on the bookmark of the current line\nBookmark comment"
    ID_FILE_NEW_THREE_WAY   "Compare two revisions with their common ancestor and merge them\nNew three-way comparison"
    ID_FILE_OPEN_IN_PANE    "Open another file in the current pane\nOpen file in current pane"
    ID_FILE_SAVE_PANE       "Save the file in the current pane\nSave current pane"
    ID_FILE_SAVE_PANE_AS    "Save the file in the current pane under a new name\nSave current pane as"
    ID_FILE_SAVE_ALL_PANES  "Save every modified file of this comparison\nSave all"
    ID_FILE_CLOSE_TAB       "Close this comparison\nClose comparison"
    ID_EDIT_FIND_TEXT       "Find text in the current pane\nFind"
    ID_EDIT_GOTO_LINE       "Jump to a line number\nGo to line"
    ID_EDIT_INDENT          "Indent the selected lines\nIndent"
    ID_EDIT_OUTDENT         "Un-indent the selected lines\nUn-indent"
    ID_VIEW_START           "Reload the files from disk and compare them again\nStart: reload and compare"
    ID_VIEW_STOP            "Stop the folder comparison in progress (Esc)\nStop"
    ID_VIEW_RECOMPARE       "Compare the files again\nRecompare"
    ID_VIEW_LAYOUT_TWO      "Show two panes (two-way comparison)\nTwo panes"
    ID_VIEW_LAYOUT_THREE    "Show three panes (three-way comparison, merging into the middle file)\nThree panes"
    ID_VIEW_STATISTICS      "Show a summary of the comparison\nComparison statistics"
    ID_MERGE_NEXT_CHANGE    "Go to the next change\nNext change"
    ID_MERGE_PREV_CHANGE    "Go to the previous change\nPrevious change"
    ID_MERGE_NEXT_CONFLICT  "Go to the next conflict\nNext conflict"
    ID_MERGE_PREV_CONFLICT  "Go to the previous conflict\nPrevious conflict"
    ID_MERGE_COPY_TO_RIGHT  "Copy the current change to the file on the right (into the middle file in a three-way comparison)\nCopy change to the right"
    ID_MERGE_COPY_TO_LEFT   "Copy the current change to the file on the left (into the middle file in a three-way comparison)\nCopy change to the left"
    ID_MERGE_AUTO           "Merge every non-conflicting change into the middle file\nAutomatic merge"
    ID_MERGE_MARK_RESOLVED  "Dim the selected lines to show they are dealt with\nMark as resolved"
    ID_MERGE_UNMARK_RESOLVED "Undim the selected lines\nUnmark resolved"
    ID_EDIT_UNDO            "Undo the last change\nUndo"
    ID_EDIT_REDO            "Redo the last undone change\nRedo"
    ID_OPT_OPTIONS          "Comparison rules, fonts and colours\nOptions"
    ID_VIEW_WORD_WRAP       "Wrap long lines at the pane width\nWord wrap"
    ID_VIEW_PADDING         "Keep corresponding blocks side by side with blank rows\nVertical padding"
    ID_VIEW_LINE_DETAIL     "Show the current lines of all files one above the other\nLine detail panel"
    ID_BOOKMARK_TOGGLE      "Set or remove a bookmark on the current line\nToggle bookmark"
    ID_BOOKMARK_NEXT        "Go to the next bookmark\nNext bookmark"
    ID_BOOKMARK_PREV        "Go to the previous bookmark\nPrevious bookmark"
    ID_SYNC_ADD             "Make the lines at the carets of all panes correspond\nSynchronize current lines"
    ID_SYNC_CLEAR           "Remove all synchronization links\nRemove synchronization links"
    ID_FILE_NEW_FOLDERS     "Compare two or three folder hierarchies\nNew folder comparison"
    ID_FILE_OPEN_PATCH      "Review a patch (unified diff) and apply chosen hunks\nOpen patch file"
    ID_VIEW_FORMAT_XML      "Open a comparison of the files laid out one XML element per line\nCompare as formatted XML"
    ID_FOLDER_DELETE_LEFT   "Move the selected items of the left folder to the Recycle Bin\nDelete from left"
    ID_FOLDER_DELETE_RIGHT  "Move the selected items of the right folder to the Recycle Bin\nDelete from right"
    ID_FOLDER_OPEN          "Compare the selected files below the folders\nShow file comparison"
    ID_FOLDER_SELECT        "Select files by name and status\nSelect files"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MERGEFILES_VERSION_MAJOR,MERGEFILES_VERSION_MINOR,MERGEFILES_VERSION_PATCH,MERGEFILES_VERSION_BUILD
 PRODUCTVERSION MERGEFILES_VERSION_MAJOR,MERGEFILES_VERSION_MINOR,MERGEFILES_VERSION_PATCH,MERGEFILES_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MergeFiles - compare and merge files"
            VALUE "FileVersion", MERGEFILES_VERSION_FULL
            VALUE "InternalName", "MergeFiles"
            VALUE "OriginalFilename", "MergeFiles.exe"
            VALUE "ProductName", "MergeFiles"
            VALUE "ProductVersion", MERGEFILES_VERSION_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
