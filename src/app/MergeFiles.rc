// MergeFiles.rc - icon, menus, accelerators, dialogs, strings and version resources
#include "resource.h"
#include "afxres.h"
#include "winres.h"
#include "Version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MAINFRAME ICON "res\\MergeFiles.ico"

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Two-Way Comparison...\tCtrl+N", ID_FILE_NEW_TWO_WAY
        MENUITEM "New &Three-Way Comparison...\tCtrl+Shift+N", ID_FILE_NEW_THREE_WAY
        MENUITEM "New &Folder Comparison...\tCtrl+D", ID_FILE_NEW_FOLDERS
        MENUITEM "Open &Patch File...\tCtrl+Shift+O", ID_FILE_OPEN_PATCH
        MENUITEM "Open Comparison Arc&hive...", ID_FILE_OPEN_ARCHIVE
        MENUITEM "&Open File in Current Pane...\tCtrl+O", ID_FILE_OPEN_IN_PANE
        MENUITEM SEPARATOR
        MENUITEM "&Save Current Pane\tCtrl+S", ID_FILE_SAVE_PANE
        MENUITEM "Save Current Pane &As...", ID_FILE_SAVE_PANE_AS
        MENUITEM "Save A&ll\tCtrl+Shift+S", ID_FILE_SAVE_ALL_PANES
        MENUITEM "Save Comparison A&rchive...", ID_FILE_SAVE_ARCHIVE
        MENUITEM SEPARATOR
        MENUITEM "Create &Report...\tCtrl+E", ID_FILE_REPORT
        MENUITEM "Page Set&up...", ID_FILE_PAGE_SETUP_MF
        MENUITEM "Print Pre&view", ID_FILE_PRINT_PREVIEW
        MENUITEM "&Print...\tCtrl+P", ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "&Close Comparison\tCtrl+W", ID_FILE_CLOSE_TAB
        MENUITEM SEPARATOR
        MENUITEM "E&xit", ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y", ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X", ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C", ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V", ID_EDIT_PASTE
        MENUITEM "Select &All\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F", ID_EDIT_FIND_TEXT
        MENUITEM "R&eplace...\tCtrl+H", ID_EDIT_REPLACE_TEXT
        MENUITEM "Find &Next\tF3", ID_EDIT_FIND_NEXT_TEXT
        MENUITEM "Find Pre&vious\tShift+F3", ID_EDIT_FIND_PREV_TEXT
        MENUITEM "&Go To Line...\tCtrl+G", ID_EDIT_GOTO_LINE
        MENUITEM SEPARATOR
        MENUITEM "&Indent\tTab", ID_EDIT_INDENT
        MENUITEM "Un-in&dent\tShift+Tab", ID_EDIT_OUTDENT
        MENUITEM SEPARATOR
        MENUITEM "Toggle &Bookmark\tCtrl+F2", ID_BOOKMARK_TOGGLE
        MENUITEM "Ne&xt Bookmark\tF2", ID_BOOKMARK_NEXT
        MENUITEM "Previous Boo&kmark\tShift+F2", ID_BOOKMARK_PREV
        MENUITEM "Bookmark Co&mment...\tCtrl+Shift+F2", ID_BOOKMARK_COMMENT
        MENUITEM "Clear All Bookmarks", ID_BOOKMARK_CLEAR
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Two Panes", ID_VIEW_LAYOUT_TWO
        MENUITEM "T&hree Panes", ID_VIEW_LAYOUT_THREE
        MENUITEM SEPARATOR
        MENUITEM "&Reload Files and Compare\tCtrl+F5", ID_VIEW_START
        MENUITEM "Re&compare\tF5", ID_VIEW_RECOMPARE
        MENUITEM "Comparison &Statistics...", ID_VIEW_STATISTICS
        MENUITEM "Compare as &Formatted XML", ID_VIEW_FORMAT_XML
        MENUITEM SEPARATOR
        MENUITEM "Zoom &In\tCtrl++", ID_VIEW_ZOOM_IN
        MENUITEM "Zoom &Out\tCtrl+-", ID_VIEW_ZOOM_OUT
        MENUITEM "Zoom to &Fit\tCtrl+0", ID_VIEW_ZOOM_FIT
        MENUITEM "&Actual Size\tCtrl+1", ID_VIEW_ZOOM_ACTUAL
        MENUITEM SEPARATOR
        MENUITEM "&Word Wrap\tCtrl+Shift+W", ID_VIEW_WORD_WRAP
        MENUITEM "Vertical &Padding\tCtrl+Shift+P", ID_VIEW_PADDING
        MENUITEM "&Line Detail Panel\tCtrl+Shift+L", ID_VIEW_LINE_DETAIL
        MENUITEM SEPARATOR
        MENUITEM "Ne&xt Tab\tCtrl+Tab", ID_VIEW_NEXT_TAB
        MENUITEM "Pre&vious Tab\tCtrl+Shift+Tab", ID_VIEW_PREV_TAB
    END
    POPUP "&Merge"
    BEGIN
        MENUITEM "&Next Change\tAlt+Down", ID_MERGE_NEXT_CHANGE
        MENUITEM "&Previous Change\tAlt+Up", ID_MERGE_PREV_CHANGE
        MENUITEM "Next &Conflict\tCtrl+Alt+Down", ID_MERGE_NEXT_CONFLICT
        MENUITEM "Previous C&onflict\tCtrl+Alt+Up", ID_MERGE_PREV_CONFLICT
        MENUITEM SEPARATOR
        MENUITEM "Copy Change to the &Right\tAlt+Right", ID_MERGE_COPY_TO_RIGHT
        MENUITEM "Copy Change to the &Left\tAlt+Left", ID_MERGE_COPY_TO_LEFT
        MENUITEM "&Automatic Merge\tCtrl+M", ID_MERGE_AUTO
        MENUITEM SEPARATOR
        MENUITEM "&Mark Selected Lines as Resolved\tCtrl+R", ID_MERGE_MARK_RESOLVED
        MENUITEM "&Unmark Selected Lines\tCtrl+Shift+R", ID_MERGE_UNMARK_RESOLVED
        MENUITEM SEPARATOR
        MENUITEM "Replace Right File with Left File", ID_MERGE_REPLACE_RIGHT
        MENUITEM "Replace Left File with Right File", ID_MERGE_REPLACE_LEFT
        MENUITEM SEPARATOR
        MENUITEM "&Synchronize the Current Lines\tCtrl+L", ID_SYNC_ADD
        MENUITEM "Remove All Synchronization Lin&ks", ID_SYNC_CLEAR
    END
    POPUP "Fol&der"
    BEGIN
        MENUITEM "&Show File Comparison\tEnter", ID_FOLDER_OPEN
        MENUITEM "Open File Comparison in a &New Tab\tShift+Enter", ID_FOLDER_OPEN_TAB
        MENUITEM "File Comparison &Below the Folders", ID_FOLDER_SPLIT
        MENUITEM SEPARATOR
        MENUITEM "Copy to the &Right\tAlt+Right", ID_MERGE_COPY_TO_RIGHT
        MENUITEM "Copy to the &Left\tAlt+Left", ID_MERGE_COPY_TO_LEFT
        MENUITEM "Delete from the Left...", ID_FOLDER_DELETE_LEFT
        MENUITEM "Delete from the Right...", ID_FOLDER_DELETE_RIGHT
        MENUITEM "&Automatic Merge into the Ancestor...\tCtrl+M", ID_MERGE_AUTO
        MENUITEM SEPARATOR
        MENUITEM "Select &Files...", ID_FOLDER_SELECT
        MENUITEM "&Expand All", ID_FOLDER_EXPAND_ALL
        MENUITEM "&Collapse All", ID_FOLDER_COLLAPSE_ALL
        MENUITEM SEPARATOR
        MENUITEM "Show &Identical", ID_FOLDER_SHOW_IDENTICAL
        MENUITEM "Show Left-Only / Changed on &Left", ID_FOLDER_SHOW_LEFT
        MENUITEM "Show Right-Only / Changed on Ri&ght", ID_FOLDER_SHOW_RIGHT
        MENUITEM "Show &Different and Conflicts", ID_FOLDER_SHOW_DIFFERENT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Compare Whitespace", ID_OPT_WS_COMPARE
        MENUITEM "Ignore Whitespace &Changes", ID_OPT_WS_IGNORE_CHANGES
        MENUITEM "Ignore &All Whitespace", ID_OPT_WS_IGNORE_ALL
        MENUITEM SEPARATOR
        MENUITEM "Ignore Ca&se", ID_OPT_IGNORE_CASE
        MENUITEM "Ignore &Line Ending Differences", ID_OPT_IGNORE_EOL
        MENUITEM "Ignore &Blank Lines", ID_OPT_IGNORE_BLANK
        MENUITEM SEPARATOR
        MENUITEM "S&yntax Highlighting", ID_OPT_SYNTAX
        MENUITEM "Show &Whitespace and Line Endings", ID_OPT_SHOW_WHITESPACE
        MENUITEM SEPARATOR
        MENUITEM "&Options...\tCtrl+,", ID_OPT_OPTIONS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "MergeFiles &Help\tF1", ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About MergeFiles...", ID_APP_ABOUT
    END
END

// Drop-down menus of the toolbar (positions: resource.h POPUP_*)
IDR_POPUPS MENU
BEGIN
    POPUP "Settings"
    BEGIN
        MENUITEM "&Compare Whitespace", ID_OPT_WS_COMPARE
        MENUITEM "Ignore Whitespace &Changes", ID_OPT_WS_IGNORE_CHANGES
        MENUITEM "Ignore &All Whitespace", ID_OPT_WS_IGNORE_ALL
        MENUITEM SEPARATOR
        MENUITEM "Ignore Ca&se", ID_OPT_IGNORE_CASE
        MENUITEM "Ignore &Line Ending Differences", ID_OPT_IGNORE_EOL
        MENUITEM "Ignore &Blank Lines", ID_OPT_IGNORE_BLANK
        MENUITEM SEPARATOR
        MENUITEM "S&yntax Highlighting", ID_OPT_SYNTAX
        MENUITEM "Show &Whitespace and Line Endings", ID_OPT_SHOW_WHITESPACE
        MENUITEM "&Word Wrap", ID_VIEW_WORD_WRAP
        MENUITEM "Vertical &Padding", ID_VIEW_PADDING
        MENUITEM "Line &Detail Panel", ID_VIEW_LINE_DETAIL
        MENUITEM SEPARATOR
        MENUITEM "&Options...", ID_OPT_OPTIONS
    END
    POPUP "Encoding"
    BEGIN
        MENUITEM "Save as UTF-8", ID_ENC_UTF8
        MENUITEM "Save as UTF-8 with BOM", ID_ENC_UTF8_BOM
        MENUITEM "Save as UTF-16 LE with BOM", ID_ENC_UTF16LE_BOM
        MENUITEM "Save as UTF-16 BE with BOM", ID_ENC_UTF16BE_BOM
        MENUITEM "Save as UTF-16 LE", ID_ENC_UTF16LE
        MENUITEM "Save as UTF-16 BE", ID_ENC_UTF16BE
        MENUITEM "Save as ANSI (system code page)", ID_ENC_ANSI
        MENUITEM SEPARATOR
        POPUP "&Reload As"
        BEGIN
            MENUITEM "Detect Automatically", ID_REOPEN_AUTO
            MENUITEM "UTF-8", ID_REOPEN_UTF8
            MENUITEM "UTF-16 LE", ID_REOPEN_UTF16LE
            MENUITEM "ANSI (system code page)", ID_REOPEN_ANSI
            MENUITEM "Japanese (Shift-JIS)", ID_REOPEN_SHIFT_JIS
            MENUITEM "Japanese (EUC-JP)", ID_REOPEN_EUC_JP
        END
        MENUITEM SEPARATOR
        MENUITEM "Line Endings: Windows (CR LF)", ID_EOL_CRLF
        MENUITEM "Line Endings: UNIX (LF)", ID_EOL_LF
        MENUITEM "Line Endings: Classic Mac (CR)", ID_EOL_CR
    END
    POPUP "Find"
    BEGIN
        MENUITEM "&Find...\tCtrl+F", ID_EDIT_FIND_TEXT
        MENUITEM "R&eplace...\tCtrl+H", ID_EDIT_REPLACE_TEXT
        MENUITEM "Find &Next\tF3", ID_EDIT_FIND_NEXT_TEXT
        MENUITEM "Find Pre&vious\tShift+F3", ID_EDIT_FIND_PREV_TEXT
        MENUITEM SEPARATOR
        MENUITEM "&Go To Line...\tCtrl+G", ID_EDIT_GOTO_LINE
    END
    POPUP "Pane"
    BEGIN
        MENUITEM "&Open File in This Pane...", ID_FILE_OPEN_IN_PANE
        MENUITEM "&Save", ID_FILE_SAVE_PANE
        MENUITEM "Save &As...", ID_FILE_SAVE_PANE_AS
        MENUITEM SEPARATOR
        MENUITEM "Cu&t", ID_EDIT_CUT
        MENUITEM "&Copy", ID_EDIT_COPY
        MENUITEM "&Paste", ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Mark Selected Lines as &Resolved", ID_MERGE_MARK_RESOLVED
        MENUITEM "&Unmark Selected Lines", ID_MERGE_UNMARK_RESOLVED
        MENUITEM SEPARATOR
        MENUITEM "Toggle &Bookmark", ID_BOOKMARK_TOGGLE
        MENUITEM "Bookmark Co&mment...", ID_BOOKMARK_COMMENT
        MENUITEM "Synchronize the Current &Lines", ID_SYNC_ADD
    END
    POPUP "Folder"
    BEGIN
        MENUITEM "&Show File Comparison", ID_FOLDER_OPEN
        MENUITEM "Open in a &New Tab", ID_FOLDER_OPEN_TAB
        MENUITEM SEPARATOR
        MENUITEM "Copy to the &Right", ID_MERGE_COPY_TO_RIGHT
        MENUITEM "Copy to the &Left", ID_MERGE_COPY_TO_LEFT
        MENUITEM "Delete from the Left...", ID_FOLDER_DELETE_LEFT
        MENUITEM "Delete from the Right...", ID_FOLDER_DELETE_RIGHT
        MENUITEM SEPARATOR
        MENUITEM "Select &Files...", ID_FOLDER_SELECT
        MENUITEM "&Expand All", ID_FOLDER_EXPAND_ALL
        MENUITEM "&Collapse All", ID_FOLDER_COLLAPSE_ALL
    END
END

