IDD_FOLDER_SELECT DIALOGEX 0, 0, 240, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Files"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Select the files whose &name matches (wildcards, separated by ;):",IDC_STATIC,8,8,224,8
    EDITTEXT        IDC_FS_PATTERN,8,20,224,14,ES_AUTOHSCROLL
    LTEXT           "and whose status is:",IDC_STATIC,8,42,224,8
    CONTROL         "&Identical",IDC_FS_IDENTICAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,54,100,10
    CONTROL         "&Left only / changed on left",IDC_FS_LEFT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,54,112,10
    CONTROL         "&Different / conflicts",IDC_FS_DIFFERENT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,68,100,10
    CONTROL         "&Right only / changed on right",IDC_FS_RIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,68,112,10
    DEFPUSHBUTTON   "Select",IDOK,128,96,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,182,96,50,14
END

IDD_OPT_FOLDERS DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Folders and Images"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Compare corresponding files by",IDC_STATIC,7,7,286,72
    CONTROL         "&Quick: size and modification time only (fastest)",IDC_OF_QUICK,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,20,270,10
    CONTROL         "&Byte by byte",IDC_OF_BINARY,"Button",BS_AUTORADIOBUTTON,14,33,270,10
    CONTROL         "&Thorough: text files with the file comparison rules (whitespace, line endings, ...)",IDC_OF_THOROUGH,"Button",BS_AUTORADIOBUTTON,14,46,276,10
    LTEXT           "Thorough mode compares files larger than",IDC_STATIC,24,62,140,8
    EDITTEXT        IDC_OF_LIMIT,166,60,30,13,ES_AUTOHSCROLL | ES_NUMBER | WS_GROUP
    LTEXT           "MB byte by byte.",IDC_STATIC,200,62,80,8
    LTEXT           "&Include files (wildcards separated by ; empty = all files):",IDC_STATIC,7,88,286,8
    EDITTEXT        IDC_OF_INCLUDE,7,99,286,14,ES_AUTOHSCROLL
    LTEXT           "&Exclude files and folders (a trailing \\ means a folder, e.g. .git\\;bin\\;*.obj):",IDC_STATIC,7,121,286,8
    EDITTEXT        IDC_OF_EXCLUDE,7,132,286,14,ES_AUTOHSCROLL
    LTEXT           "Open folder comparisons are compared again when these settings change.",IDC_STATIC,7,152,286,8
    LTEXT           "&Image colour tolerance (0 - 255 per channel):",IDC_STATIC,7,170,170,8
    EDITTEXT        IDC_OF_IMAGE_TOLERANCE,180,168,30,13,ES_AUTOHSCROLL | ES_NUMBER
END

