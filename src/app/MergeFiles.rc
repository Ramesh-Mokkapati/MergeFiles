IDD_NEW_COMPARISON DIALOGEX 0, 0, 380, 148
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Comparison"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "&Two-way comparison",IDC_NC_TWO_WAY,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,10,8,100,10
    CONTROL         "T&hree-way comparison (merge into the common ancestor)",IDC_NC_THREE_WAY,"Button",BS_AUTORADIOBUTTON,116,8,220,10
    LTEXT           "&Left file:",IDC_NC_LEFT_LABEL,10,30,56,8
    EDITTEXT        IDC_NC_LEFT,70,28,244,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "Browse...",IDC_NC_BROWSE_LEFT,318,28,52,14
    LTEXT           "&Ancestor:",IDC_NC_MIDDLE_LABEL,10,50,56,8
    EDITTEXT        IDC_NC_MIDDLE,70,48,244,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_NC_BROWSE_MIDDLE,318,48,52,14
    LTEXT           "&Right file:",IDC_NC_RIGHT_LABEL,10,70,56,8
    EDITTEXT        IDC_NC_RIGHT,70,68,244,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_NC_BROWSE_RIGHT,318,68,52,14
    CONTROL         "Compare &folders",IDC_NC_FOLDERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,70,88,200,10
    LTEXT           "Tip: drop two or three files (or folders) from File Explorer onto the window to compare them.",IDC_NC_HINT,10,104,360,8
    DEFPUSHBUTTON   "Compare",IDOK,262,124,52,16
    PUSHBUTTON      "Cancel",IDCANCEL,318,124,52,16
END

IDD_FIND_REPLACE DIALOGEX 0, 0, 300, 112
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Find and Replace"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Fi&nd:",IDC_STATIC,8,10,42,8
    EDITTEXT        IDC_FR_FIND,54,8,170,14,ES_AUTOHSCROLL
    LTEXT           "Re&place:",IDC_STATIC,8,30,42,8
    EDITTEXT        IDC_FR_REPLACE,54,28,170,14,ES_AUTOHSCROLL
    CONTROL         "Match &case",IDC_FR_MATCH_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,54,48,80,10
    CONTROL         "&Whole word",IDC_FR_WHOLE_WORD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,54,60,80,10
    CONTROL         "Replace All in &selection",IDC_FR_SELECTION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,138,48,92,10
    CONTROL         "Wrap ar&ound",IDC_FR_WRAP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,138,60,86,10
    DEFPUSHBUTTON   "Find &Next",IDC_FR_FIND_NEXT,232,8,60,14
    PUSHBUTTON      "Find Pre&vious",IDC_FR_FIND_PREV,232,26,60,14
    PUSHBUTTON      "&Replace",IDC_FR_REPLACE_ONE,232,44,60,14
    PUSHBUTTON      "Replace &All",IDC_FR_REPLACE_ALL,232,62,60,14
    PUSHBUTTON      "Close",IDCANCEL,232,90,60,14
    LTEXT           "",IDC_FR_STATUS,8,93,216,8,SS_ENDELLIPSIS
END

IDD_GOTO_LINE DIALOGEX 0, 0, 200, 64
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go To Line"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_GT_RANGE,8,8,184,8
    EDITTEXT        IDC_GT_LINE,8,20,184,14,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Go",IDOK,86,42,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,142,42,50,14
END

IDD_STATISTICS DIALOGEX 0, 0, 260, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Comparison Statistics"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_STATS_TEXT,8,8,244,136,ES_MULTILINE | ES_READONLY | WS_VSCROLL
    DEFPUSHBUTTON   "Close",IDOK,202,150,50,14
END

IDD_OPT_COMPARE DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Comparison"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Whitespace",IDC_STATIC,7,7,286,50
    CONTROL         "&Compare whitespace",IDC_OC_WS_COMPARE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,19,200,10
    CONTROL         "Ignore whitespace c&hanges (runs of spaces and tabs compare equal)",IDC_OC_WS_CHANGES,"Button",BS_AUTORADIOBUTTON,14,31,270,10
    CONTROL         "Ignore &all whitespace",IDC_OC_WS_ALL,"Button",BS_AUTORADIOBUTTON,14,43,200,10
    CONTROL         "Ignore ca&se",IDC_OC_CASE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,64,200,10
    CONTROL         "Ignore &line ending differences (CR LF, LF, CR)",IDC_OC_EOL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,77,240,10
    CONTROL         "Ignore inserted or removed &blank lines",IDC_OC_BLANK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,90,240,10
    GROUPBOX        "Numeric tolerance (0 = off)",IDC_STATIC,7,108,286,58
    LTEXT           "Numbers that differ by at most this much compare equal.",IDC_STATIC,14,120,270,8
    LTEXT           "Ab&solute:",IDC_STATIC,14,136,50,8
    EDITTEXT        IDC_OC_ABS,66,134,70,13,ES_AUTOHSCROLL
    LTEXT           "&Relative (%):",IDC_STATIC,150,136,50,8
    EDITTEXT        IDC_OC_REL,204,134,70,13,ES_AUTOHSCROLL
    LTEXT           "Example: 0.001 absolute, or 0.5 relative (half a percent).",IDC_STATIC,14,152,270,8
END

IDD_OPT_RULES DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Rules"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Line expressions: text matching these regular expressions is left out when lines are compared (one per line, e.g. //.*$ for C++ comments).",IDC_STATIC,7,5,286,17
    EDITTEXT        IDC_OR_LINE,7,24,286,38,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "&Block expressions: lines from one matching Begin up to the next matching End are ignored (the Nth End pairs with the Nth Begin).",IDC_STATIC,7,67,286,17
    LTEXT           "Begin:",IDC_STATIC,7,87,40,8
    EDITTEXT        IDC_OR_BEGIN,7,97,140,36,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "End:",IDC_STATIC,153,87,40,8
    EDITTEXT        IDC_OR_END,153,97,140,36,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Line-&pairing rule: inside a changed block, lines whose first capture group matches correspond (e.g. ^(\\w+)= for key=value files).",IDC_STATIC,7,139,286,17
    EDITTEXT        IDC_OR_PAIRING,7,158,286,13,ES_AUTOHSCROLL
    LTEXT           "Regular expressions use ECMAScript syntax.",IDC_STATIC,7,176,286,8
END

IDD_OPT_DISPLAY DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Display"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Font:",IDC_STATIC,7,9,30,8
    LTEXT           "",IDC_OD_FONT_NAME,40,9,170,8,SS_ENDELLIPSIS
    PUSHBUTTON      "&Font...",IDC_OD_FONT,233,6,60,14
    LTEXT           "&Tab size:",IDC_STATIC,7,27,40,8
    EDITTEXT        IDC_OD_TAB,50,25,30,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "&Wrap long lines",IDC_OD_WRAP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,44,140,10
    CONTROL         "Vertical &padding (align blocks with blank rows)",IDC_OD_PADDING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,56,190,10
    CONTROL         "Line &detail panel",IDC_OD_DETAIL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,68,140,10
    CONTROL         "&Syntax highlighting",IDC_OD_SYNTAX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,44,130,10
    CONTROL         "Show w&hitespace and line endings",IDC_OD_WHITESPACE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,68,133,10
    LTEXT           "&Colours:",IDC_STATIC,7,86,40,8
    LISTBOX         IDC_OD_COLORS,7,96,190,88,LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_OD_SWATCH,"Static",SS_SUNKEN | SS_NOTIFY,205,96,88,24
